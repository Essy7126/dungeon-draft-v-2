[resource]
script = ExtResource("1_data")
display_name = "Lanternbound Archivist"
dialogue_text = "Au-delà de cette porte, le chemin change à chaque passage.\nPrépare ton groupe. Lorsque tu seras prêt, je consignerai votre départ."
trade_prototype_text = "Les registres d'échange sont encore scellés. Ce prototype valide uniquement l'ouverture, la fermeture et le verrouillage du déplacement."
available_runs = Array[ExtResource("2_run_type")]([ExtResource("3_main_run"), ExtResource("4_test_run"), ExtResource("5_odyssey_run")])
hero_sources = Array[String](["res://data/units/alliés/elfe.tres", "res://data/units/alliés/mage.tres", "res://data/units/alliés/Guerrier.tres"])
