{
  "name": "dungeon-draft-observatory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "generate:build-meta": "node scripts/generate-build-meta.mjs",
    "predev": "npm run generate:build-meta",
    "pretest": "npm run generate:build-meta",
    "prebuild": "npm run generate:build-meta",
    "pree2e": "npm run generate:build-meta",
    "sync:schema": "node scripts/sync-schema.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "dev": "npm run sync:schema && vite",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:automation:server": "node --test ../tools/observatory/live/tests/observatory-lan-server.test.mjs",
    "test:watch": "vitest",
    "build": "npm run sync:schema && npm run validate:data && vite build",
    "preview": "vite preview",
    "e2e": "npm run sync:schema && playwright test",
    "check": "npm run sync:schema && npm run validate:data && npm run lint && npm run typecheck && npm run test && npm run build && npm run e2e"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "5.3.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/react-router-dom": "5.3.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
