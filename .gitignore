# Godot 4+ specific ignores
.godot/
/android/
artifacts/*
!artifacts/arena_studio/
!artifacts/arena_studio/**
!artifacts/item_studio/
artifacts/item_studio/*
!artifacts/item_studio/characterization.json
output/*
!output/.gdignore
tests/characters/**/screenshots/
*.blend1

# Fichiers temporaires de l'éditeur (sauvegardes de scène en cours d'écriture)
*.tmp
*.tmp[0-9]*

addons/godot_ai_workbench/icon.png.import
tests/characters/elf/screenshots/*.png.import

# Outils locaux propres au poste de développement
.claude/settings.local.json
addons/ziva_agent/
