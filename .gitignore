# Godot 4+ specific ignores
.godot/
/android/
artifacts/*
!artifacts/arena_studio/
!artifacts/arena_studio/**
!artifacts/item_studio/
artifacts/item_studio/*
!artifacts/item_studio/characterization.json
output/*
!output/.gdignore
tests/characters/**/screenshots/
/data/runs/__g6_closure_e2e/
*.blend1

# Fichiers temporaires de l'éditeur (sauvegardes de scène en cours d'écriture)
*.tmp
*.tmp[0-9]*

addons/godot_ai_workbench/icon.png.import
tests/characters/elf/screenshots/*.png.import

# Outils locaux propres au poste de développement
.claude/settings.local.json
.codex/config.toml
addons/ziva_agent/

# Local inspection previews and Python caches (source art is versioned).
meshy_output/review/
**/__pycache__/
*.pyc

# Spine evaluation runtime; restored by tools/spine_trial/install.ps1.
/addons/spine_godot_trial/
