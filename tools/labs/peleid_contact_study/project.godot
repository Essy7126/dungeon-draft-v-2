; Isolated research scene: no game autoloads and no content publication.
config_version=5

[application]
config/name="Catabase - étude du contact peint"
run/main_scene="res://Study.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1200
window/size/viewport_height=780
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
textures/default_filters/use_nearest_mipmap_filter=false
