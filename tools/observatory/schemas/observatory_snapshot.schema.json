{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dungeon-draft.local/schemas/observatory_snapshot.schema.json",
  "title": "Dungeon Draft Observatory Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "scope",
    "summary",
    "contract",
    "characters",
    "disciplines",
    "spells",
    "items",
    "reward_pools",
    "contract_checks",
    "audit_results"
  ],
  "properties": {
    "meta": {"$ref": "#/$defs/meta"},
    "scope": {"$ref": "#/$defs/scope"},
    "summary": {"$ref": "#/$defs/summary"},
    "contract": {"$ref": "#/$defs/contract"},
    "characters": {
      "type": "array",
      "items": {"$ref": "#/$defs/character"}
    },
    "disciplines": {
      "type": "array",
      "items": {"$ref": "#/$defs/discipline"}
    },
    "spells": {
      "type": "array",
      "items": {"$ref": "#/$defs/spell"}
    },
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    },
    "reward_pools": {
      "type": "array",
      "items": {"$ref": "#/$defs/rewardPool"}
    },
    "contract_checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/contractCheck"}
    },
    "audit_results": {
      "type": "array",
      "items": {"$ref": "#/$defs/auditResult"}
    }
  },
  "$defs": {
    "jsonValue": {
      "anyOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "number"},
        {"type": "string"},
        {"type": "array", "items": {"$ref": "#/$defs/jsonValue"}},
        {
          "type": "object",
          "propertyNames": {"type": "string"},
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        }
      ]
    },
    "enumValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "name"],
      "properties": {
        "value": {"type": "integer"},
        "name": {"type": "string"}
      }
    },
    "resourceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_type", "resource_path"],
      "properties": {
        "resource_type": {"type": "string"},
        "resource_path": {"type": "string", "pattern": "^(res://.*)?$"}
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generator_version",
        "generated_at_utc",
        "source_game_commit",
        "source_branch",
        "source_worktree_dirty_before_export",
        "godot_version",
        "project_name",
        "contract_version",
        "manifest_version"
      ],
      "properties": {
        "schema_version": {"type": "string", "minLength": 1},
        "generator_version": {"type": "string", "minLength": 1},
        "generated_at_utc": {"type": "string", "minLength": 1},
        "source_game_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_branch": {"type": "string", "minLength": 1},
        "source_worktree_dirty_before_export": {"type": "boolean"},
        "godot_version": {"type": "string", "minLength": 1},
        "project_name": {"type": "string", "minLength": 1},
        "contract_version": {"type": "string", "minLength": 1},
        "manifest_version": {"type": "string", "minLength": 1}
      }
    },
    "scopeDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "reason"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "status": {"type": "string"},
        "path": {"type": "string"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included_domains", "deferred_domains", "excluded_domains"],
      "properties": {
        "included_domains": {"type": "array", "items": {"type": "string"}},
        "deferred_domains": {"type": "array", "items": {"$ref": "#/$defs/scopeDomain"}},
        "excluded_domains": {"type": "array", "items": {"$ref": "#/$defs/scopeDomain"}}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characters",
        "disciplines",
        "spells",
        "items",
        "generic_rewards",
        "reward_pools",
        "eligible_first_run_equipment",
        "contract_conform",
        "contract_difference",
        "contract_unknown",
        "contract_not_evaluated",
        "audit_info",
        "audit_warning",
        "audit_blocking"
      ],
      "properties": {
        "characters": {"type": "integer", "minimum": 0},
        "disciplines": {"type": "integer", "minimum": 0},
        "spells": {"type": "integer", "minimum": 0},
        "items": {"type": "integer", "minimum": 0},
        "generic_rewards": {"type": "integer", "minimum": 0},
        "reward_pools": {"type": "integer", "minimum": 0},
        "eligible_first_run_equipment": {"type": "integer", "minimum": 0},
        "contract_conform": {"type": "integer", "minimum": 0},
        "contract_difference": {"type": "integer", "minimum": 0},
        "contract_unknown": {"type": "integer", "minimum": 0},
        "contract_not_evaluated": {"type": "integer", "minimum": 0},
        "audit_info": {"type": "integer", "minimum": 0},
        "audit_warning": {"type": "integer", "minimum": 0},
        "audit_blocking": {"type": "integer", "minimum": 0}
      }
    },
    "contractDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "value", "status", "source", "rationale"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "value": {"$ref": "#/$defs/jsonValue"},
        "status": {"enum": ["validated", "provisional", "unknown", "deprecated"]},
        "source": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "decisions"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "decisions": {"type": "array", "items": {"$ref": "#/$defs/contractDecision"}}
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "role", "presentation_summary",
        "progression_summary", "presentation_badge", "team", "max_hp",
        "initiative", "max_ap", "max_mp", "attack_power", "force", "armour",
        "magic_resistance", "dodge", "resistances", "critical_chance",
        "critical_multiplier", "basic_attack_enabled", "active_spell_slots",
        "spell_ids", "discipline_ids", "visual_scene_path",
        "preview_visual_scene_path", "source_path"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "role": {"type": "string"},
        "presentation_summary": {"type": "string"},
        "progression_summary": {"type": "string"},
        "presentation_badge": {"type": "string"},
        "team": {"type": "integer"},
        "max_hp": {"type": "integer"},
        "initiative": {"type": "integer"},
        "max_ap": {"type": "integer"},
        "max_mp": {"type": "integer"},
        "attack_power": {"type": "integer"},
        "force": {"type": "number"},
        "armour": {"type": "number"},
        "magic_resistance": {"type": "number"},
        "dodge": {"type": "number"},
        "resistances": {"$ref": "#/$defs/jsonValue"},
        "critical_chance": {"type": "number"},
        "critical_multiplier": {"type": "number"},
        "basic_attack_enabled": {"type": "boolean"},
        "active_spell_slots": {"type": "integer"},
        "spell_ids": {"type": "array", "items": {"type": "string"}},
        "discipline_ids": {"type": "array", "items": {"type": "string"}},
        "visual_scene_path": {"type": "string"},
        "preview_visual_scene_path": {"type": "string"},
        "source_path": {"type": "string", "pattern": "^res://"}
      }
    },
    "modifier": {
      "type": "object",
      "propertyNames": {"type": "string"},
      "additionalProperties": {"$ref": "#/$defs/jsonValue"}
    },
    "spell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "discipline_id", "name", "description", "referenced_by_character_ids",
        "ap_cost", "minimum_range", "range", "needs_line_of_sight",
        "cooldown_activations", "initial_cooldown", "max_uses_per_combat",
        "once_per_activation", "can_target_enemy", "can_target_ally",
        "can_target_free_cell", "can_target_self", "aoe_shape", "aoe_size",
        "line_from_caster", "damage", "heal", "shield_grant", "damage_type",
        "element", "critical_chance", "terrain_effect", "applied_status",
        "push_distance", "pull_distance", "collision_damage", "cluster_bonus_damage",
        "ap_drain", "teleport_behind_target", "delayed_resolution", "summon",
        "summon_type", "modifiers", "serialization_warnings", "icon_path",
        "vfx_scene_path", "sound_path", "source_path"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "discipline_id": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "referenced_by_character_ids": {"type": "array", "items": {"type": "string"}},
        "ap_cost": {"type": "integer"},
        "minimum_range": {"type": "integer"},
        "range": {"type": "integer"},
        "needs_line_of_sight": {"type": "boolean"},
        "cooldown_activations": {"type": "integer"},
        "initial_cooldown": {"type": "integer"},
        "max_uses_per_combat": {"type": "integer"},
        "once_per_activation": {"type": "boolean"},
        "can_target_enemy": {"type": "boolean"},
        "can_target_ally": {"type": "boolean"},
        "can_target_free_cell": {"type": "boolean"},
        "can_target_self": {"type": "boolean"},
        "aoe_shape": {"$ref": "#/$defs/enumValue"},
        "aoe_size": {"type": "integer"},
        "line_from_caster": {"type": "boolean"},
        "damage": {"type": "integer"},
        "heal": {"type": "integer"},
        "shield_grant": {"type": "integer"},
        "damage_type": {"$ref": "#/$defs/enumValue"},
        "element": {"$ref": "#/$defs/enumValue"},
        "critical_chance": {"type": "number"},
        "terrain_effect": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/resourceReference"}]},
        "applied_status": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/resourceReference"}]},
        "push_distance": {"type": "integer"},
        "pull_distance": {"type": "integer"},
        "collision_damage": {"type": "integer"},
        "cluster_bonus_damage": {"type": "integer"},
        "ap_drain": {"type": "integer"},
        "teleport_behind_target": {"type": "boolean"},
        "delayed_resolution": {"$ref": "#/$defs/enumValue"},
        "summon": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/resourceReference"}]},
        "summon_type": {"type": "string"},
        "modifiers": {"type": "array", "items": {"$ref": "#/$defs/modifier"}},
        "serialization_warnings": {"type": "array", "items": {"type": "string"}},
        "icon_path": {"type": "string"},
        "vfx_scene_path": {"type": "string"},
        "sound_path": {"type": "string"},
        "source_path": {"type": "string", "pattern": "^res://"}
      }
    },
    "choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upgrade_id", "name", "description", "discipline_id", "rank",
        "target_spell_id", "prerequisite_ids", "excluded_ids", "modifiers", "source_path"
      ],
      "properties": {
        "upgrade_id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "discipline_id": {"type": "string"},
        "rank": {"type": "integer"},
        "target_spell_id": {"type": "string"},
        "prerequisite_ids": {"type": "array", "items": {"type": "string"}},
        "excluded_ids": {"type": "array", "items": {"type": "string"}},
        "modifiers": {"type": "array", "items": {"$ref": "#/$defs/modifier"}},
        "source_path": {"type": "string"}
      }
    },
    "rank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "required_total_xp", "choices", "source_path"],
      "properties": {
        "rank": {"type": "integer"},
        "required_total_xp": {"type": "integer"},
        "choices": {"type": "array", "items": {"$ref": "#/$defs/choice"}},
        "source_path": {"type": "string"}
      }
    },
    "discipline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "character_id", "name", "description", "presentation_color",
        "rank_count", "total_choice_count", "ranks", "icon_path", "source_path"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "character_id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "presentation_color": {"$ref": "#/$defs/jsonValue"},
        "rank_count": {"type": "integer", "minimum": 0},
        "total_choice_count": {"type": "integer", "minimum": 0},
        "ranks": {"type": "array", "items": {"$ref": "#/$defs/rank"}},
        "icon_path": {"type": "string"},
        "source_path": {"type": "string", "pattern": "^res://"}
      }
    },
    "statModifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stat_id", "value", "modifier_type", "source_path"],
      "properties": {
        "stat_id": {"type": "string"},
        "value": {"type": "number"},
        "modifier_type": {"$ref": "#/$defs/enumValue"},
        "source_path": {"type": "string"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "rarity", "tags", "category",
        "equipment_slot", "stack_limit", "compatible_character_ids",
        "stat_modifiers", "spell_modifiers", "use_effect", "use_value",
        "equippable", "consumable", "valid", "pool_ids", "reward_fx_profile",
        "reward_audio_profile", "icon_path", "inventory_icon_path",
        "card_texture_path", "source_path"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "rarity": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string"}},
        "category": {"$ref": "#/$defs/enumValue"},
        "equipment_slot": {"$ref": "#/$defs/enumValue"},
        "stack_limit": {"type": "integer"},
        "compatible_character_ids": {"type": "array", "items": {"type": "string"}},
        "stat_modifiers": {"type": "array", "items": {"$ref": "#/$defs/statModifier"}},
        "spell_modifiers": {"type": "array", "items": {"$ref": "#/$defs/modifier"}},
        "use_effect": {"$ref": "#/$defs/enumValue"},
        "use_value": {"type": "number"},
        "equippable": {"type": "boolean"},
        "consumable": {"type": "boolean"},
        "valid": {"type": "boolean"},
        "pool_ids": {"type": "array", "items": {"type": "string"}},
        "reward_fx_profile": {"type": "string"},
        "reward_audio_profile": {"type": "string"},
        "icon_path": {"type": "string"},
        "inventory_icon_path": {"type": "string"},
        "card_texture_path": {"type": "string"},
        "source_path": {"type": "string", "pattern": "^res://"}
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "description", "reward_type", "target_policy", "value",
        "valid", "usage_status", "icon_path", "source_path"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "reward_type": {"$ref": "#/$defs/enumValue"},
        "target_policy": {"$ref": "#/$defs/enumValue"},
        "value": {"type": "number"},
        "valid": {"type": "boolean"},
        "usage_status": {"type": "string"},
        "icon_path": {"type": "string"},
        "source_path": {"type": "string", "pattern": "^res://"}
      }
    },
    "rewardPool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "kind", "mechanism", "status", "required_tag",
        "minimum_options", "item_ids", "rewards", "source_path"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "kind": {"enum": ["generic_declared", "equipment_first_run"]},
        "mechanism": {"type": "string"},
        "status": {"type": "string"},
        "required_tag": {"type": "string"},
        "minimum_options": {"type": "integer", "minimum": 0},
        "item_ids": {"type": "array", "items": {"type": "string"}},
        "rewards": {"type": "array", "items": {"$ref": "#/$defs/reward"}},
        "source_path": {"type": "string", "pattern": "^res://"}
      }
    },
    "contractCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "target", "observed_value", "status", "evidence", "message"],
      "properties": {
        "key": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/jsonValue"},
        "observed_value": {"$ref": "#/$defs/jsonValue"},
        "status": {"enum": ["conform", "difference", "unknown", "not_evaluated"]},
        "evidence": {"type": "string"},
        "message": {"type": "string"}
      }
    },
    "auditResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id", "severity", "status", "domain", "entity_type", "entity_id",
        "message", "source_path", "evidence", "suggested_action"
      ],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["info", "warning", "blocking"]},
        "status": {"type": "string"},
        "domain": {"type": "string"},
        "entity_type": {"type": "string"},
        "entity_id": {"type": "string"},
        "message": {"type": "string"},
        "source_path": {"type": "string"},
        "evidence": {"type": "string"},
        "suggested_action": {"type": "string"}
      }
    }
  }
}
