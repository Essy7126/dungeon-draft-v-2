[sub_resource type="Shader" id="Shader_icon_polish"]
code = "shader_type canvas_item;\nuniform float saturation : hint_range(0.0, 1.2) = 0.9;\nuniform float brightness : hint_range(0.0, 1.3) = 0.96;\nvoid fragment() {\n\tvec4 source = texture(TEXTURE, UV);\n\tfloat luminance = dot(source.rgb, vec3(0.2126, 0.7152, 0.0722));\n\tsource.rgb = mix(vec3(luminance), source.rgb, saturation) * brightness;\n\tCOLOR = source * COLOR;\n}\n"

