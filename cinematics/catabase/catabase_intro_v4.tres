[sub_resource type="Resource" id="Cue_005"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_005"
fallback_text = "Depuis dix ans, les Grecs assiègent la cité."
start_time_seconds = 6.42
end_time_seconds = 10.18
style_id = &"narrative"
fade_in_seconds = 0.32
fade_out_seconds = 0.32

[sub_resource type="Resource" id="Cue_006"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_006"
fallback_text = "Sa mère, la déesse Thétis,\nlui avait révélé deux destins."
start_time_seconds = 11.0
end_time_seconds = 14.48
style_id = &"narrative_small"
fade_in_seconds = 0.32
fade_out_seconds = 0.32

[sub_resource type="Resource" id="Cue_007"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_007"
fallback_text = "Rentrer chez lui. Vivre longtemps.\nEt voir sa gloire s’éteindre."
start_time_seconds = 14.88
end_time_seconds = 19.02
style_id = &"narrative_small"
fade_in_seconds = 0.32
fade_out_seconds = 0.32

[sub_resource type="Resource" id="Cue_008"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_008"
fallback_text = "Ou rester à Troie. Mourir jeune.\nEt laisser aux hommes un nom impérissable."
start_time_seconds = 19.48
end_time_seconds = 24.68
style_id = &"narrative_small"
fade_in_seconds = 0.34
fade_out_seconds = 0.36

[sub_resource type="Resource" id="Cue_009"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_009"
fallback_text = "Hector tua Patrocle,\nson plus proche compagnon."
start_time_seconds = 25.38
end_time_seconds = 28.34
style_id = &"narrative_small"
fade_in_seconds = 0.3
fade_out_seconds = 0.3

[sub_resource type="Resource" id="Cue_010"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_010"
fallback_text = "Achille resta. Il tua Hector pour le venger,\nsachant que sa propre mort suivrait."
start_time_seconds = 28.72
end_time_seconds = 32.36
style_id = &"narrative_small"
fade_in_seconds = 0.3
fade_out_seconds = 0.34

[sub_resource type="Resource" id="Cue_011"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_011"
fallback_text = "Puis Paris décocha la flèche."
start_time_seconds = 33.0
end_time_seconds = 35.58
style_id = &"narrative"
fade_in_seconds = 0.28
fade_out_seconds = 0.26

[sub_resource type="Resource" id="Cue_012"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_012"
fallback_text = "Achille mourut devant Troie."
start_time_seconds = 35.92
end_time_seconds = 38.18
style_id = &"narrative"
fade_in_seconds = 0.26
fade_out_seconds = 0.26

[sub_resource type="Resource" id="Cue_013"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_013"
fallback_text = "Une vie brève. Un nom impérissable."
start_time_seconds = 38.42
end_time_seconds = 40.4
style_id = &"key"
fade_in_seconds = 0.24
fade_out_seconds = 0.3

[sub_resource type="Resource" id="Cue_014"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_014"
fallback_text = "Il avait obtenu ce qu’il avait choisi."
start_time_seconds = 41.0
end_time_seconds = 43.96
style_id = &"narrative"
fade_in_seconds = 0.3
fade_out_seconds = 0.32

[sub_resource type="Resource" id="Cue_015"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_015"
fallback_text = "Les hommes gardèrent la légende."
start_time_seconds = 44.3
end_time_seconds = 47.18
style_id = &"narrative"
fade_in_seconds = 0.3
fade_out_seconds = 0.32

[sub_resource type="Resource" id="Cue_016"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_016"
fallback_text = "Les Enfers reçurent l’homme."
start_time_seconds = 47.52
end_time_seconds = 50.34
style_id = &"key"
fade_in_seconds = 0.32
fade_out_seconds = 0.42
layer = 1

[sub_resource type="Resource" id="Cue_017"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_017"
fallback_text = "Il était mort."
start_time_seconds = 51.0
end_time_seconds = 53.18
style_id = &"narrative"
fade_in_seconds = 0.26
fade_out_seconds = 0.26

[sub_resource type="Resource" id="Cue_018"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_018"
fallback_text = "Mais il portait encore en lui\nles passions des vivants."
start_time_seconds = 53.52
end_time_seconds = 57.28
style_id = &"narrative_small"
fade_in_seconds = 0.3
fade_out_seconds = 0.3

[sub_resource type="Resource" id="Cue_019"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_019"
fallback_text = "La vengeance. La victoire.\nLa domination. La renommée."
start_time_seconds = 57.82
end_time_seconds = 60.34
style_id = &"passions"
fade_in_seconds = 0.26
fade_out_seconds = 0.26

[sub_resource type="Resource" id="Cue_020"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_020"
fallback_text = "Dans les Enfers, aucune victoire ne rend la vie.\nAucun nom n’ouvre un avenir."
start_time_seconds = 60.58
end_time_seconds = 63.34
style_id = &"narrative_small"
fade_in_seconds = 0.26
fade_out_seconds = 0.32

[sub_resource type="Resource" id="Cue_021"]
script = ExtResource("3_cue")
localization_key = &"CATABASE_INTRO_021"
fallback_text = "Sa vengeance avait encore un visage."
start_time_seconds = 64.0
end_time_seconds = 66.1
style_id = &"narrative"
fade_in_seconds = 0.26
fade_out_seconds = 0.24

