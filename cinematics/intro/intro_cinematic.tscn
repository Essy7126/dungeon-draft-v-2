[sub_resource type="Shader" id="Shader_vignette"]
code = "shader_type canvas_item;\nrender_mode unshaded;\n\nfloat intro_hash(vec2 point) {\n\treturn fract(sin(dot(point, vec2(12.9898, 78.233))) * 43758.5453);\n}\n\nvoid fragment() {\n\tvec2 centered = UV * 2.0 - 1.0;\n\tfloat vignette = smoothstep(0.48, 1.12, length(centered * vec2(0.88, 1.04)));\n\tfloat grain = intro_hash(floor(UV * vec2(480.0, 270.0)) + floor(TIME * 4.0));\n\tfloat alpha = vignette * 0.22 + grain * 0.012;\n\tCOLOR = vec4(0.0, 0.0, 0.0, alpha);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_vignette"]
