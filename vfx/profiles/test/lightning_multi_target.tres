parameters = {"count": 9}

[sub_resource type="Resource" id="Sequence_play"]
script = ExtResource("2_sequence")
sequence_id = &"play"
display_name = "Multi-target strike"
modules = Array[ExtResource("3_module")]([SubResource("Module_lightning"), SubResource("Module_impacts")])

[resource]
script = ExtResource("1_profile")
schema_version = 1
profile_id = &"test.lightning.multi_target"
