[gd_resource type="Resource" script_class="VFXFlipbookAsset" load_steps=10 format=3]

[ext_resource type="Script" path="res://vfx/data/vfx_flipbook_asset.gd" id="1_asset"]
[ext_resource type="Script" path="res://vfx/data/vfx_flipbook_variant.gd" id="2_variant"]
[ext_resource type="Texture2D" path="res://vfx/assets/flipbooks/test/variant_a_low.png" id="3_a_low"]
[ext_resource type="Texture2D" path="res://vfx/assets/flipbooks/test/variant_a_medium.png" id="4_a_medium"]
[ext_resource type="Texture2D" path="res://vfx/assets/flipbooks/test/variant_a_high.png" id="5_a_high"]
[ext_resource type="Texture2D" path="res://vfx/assets/flipbooks/test/variant_b_low.png" id="6_b_low"]
[ext_resource type="Texture2D" path="res://vfx/assets/flipbooks/test/variant_b_medium.png" id="7_b_medium"]
[ext_resource type="Texture2D" path="res://vfx/assets/flipbooks/test/variant_b_high.png" id="8_b_high"]

[sub_resource type="Resource" id="Variant_a"]
script = ExtResource("2_variant")
variant_id = &"variant_a"
texture_low = ExtResource("3_a_low")
texture_medium = ExtResource("4_a_medium")
texture_high = ExtResource("5_a_high")

[sub_resource type="Resource" id="Variant_b"]
script = ExtResource("2_variant")
variant_id = &"variant_b"
texture_low = ExtResource("6_b_low")
texture_medium = ExtResource("7_b_medium")
texture_high = ExtResource("8_b_high")

[resource]
script = ExtResource("1_asset")
schema_version = 1
asset_id = &"synthetic.flipbook.foundation"
display_name = "Synthetic Flipbook Foundation - TEST"
variants = Array[ExtResource("2_variant")]([SubResource("Variant_a"), SubResource("Variant_b")])
columns = 8
rows = 4
frame_count = 32
frames_per_second = 30.0
loop = false
playback_mode = &"FIT_MODULE_DURATION"
blend_mode = &"ADD"
alpha_mode = &"STRAIGHT"
pivot_normalized = Vector2(0.5, 0.75)
nominal_size_in_cells = Vector2(1, 1)
local_offset = Vector2(0, -8)
art_status = &"TECHNICAL_PLACEHOLDER"
license_status = &"INTERNAL_TEST"
manifest_path = "res://vfx/manifests/test/synthetic_flipbook_foundation.json"
