[resource]
script = ExtResource("1")
unit_id = &"catabase_shadow_paris"
unit_name = "L’Ombre de Paris"
description = "Archer grec spectral : flèches d’ombre, de feu, de glace et du vortex. Sous 20 % de ses PV initiaux, une seule fois, sa forme infernale remplace l’arc par un fouet de feu et gagne 30 bouclier. Aucun soin ni retour à la vie."
team = 1
max_hp = 120
initiative = 9
max_ap = 4
max_mp = 3
attack_power = 9
