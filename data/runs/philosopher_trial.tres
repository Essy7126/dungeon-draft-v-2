[gd_resource type="Resource" script_class="RunData" load_steps=7 format=3]

[ext_resource type="Script" path="res://data/runs/run_data.gd" id="1_run"]
[ext_resource type="Script" path="res://data/rooms/room_data.gd" id="2_room_type"]
[ext_resource type="Resource" path="res://data/runs/profiles/odyssey_content_profile.tres" id="3_content"]
[ext_resource type="Resource" path="res://data/runs/economy/odyssey_economy_profile.tres" id="4_economy"]
