[ext_resource type="Resource" path="res://data/characters/philosopher_mage/attack_classifications.tres" id="6_actions"]

[resource]
script = ExtResource("1_run")
run_name = "L’Épreuve du Dialecticien"
default_seed = 906
randomize_seed_each_run = false
target_duration_minutes = 6
extended_duration_minutes = 10
room_flow_mode = 0
