[gd_resource type="Resource" script_class="RunEconomyProfile" load_steps=4 format=3]

[ext_resource type="Script" path="res://data/runs/economy/run_economy_profile.gd" id="1_profile"]
[ext_resource type="Script" path="res://data/runs/economy/run_starting_item_data.gd" id="2_item"]

[sub_resource type="Resource" id="HealingPotions"]
script = ExtResource("2_item")
item_id = &"minor_healing_potion"
quantity = 2

[sub_resource type="Resource" id="ActionScroll"]
script = ExtResource("2_item")
item_id = &"minor_action_scroll"

[resource]
script = ExtResource("1_profile")
starting_items = Array[ExtResource("2_item")]([SubResource("HealingPotions"), SubResource("ActionScroll")])
equipment_rewards_enabled = false
equipment_reward_pool_tag = &""
