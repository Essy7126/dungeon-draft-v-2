[gd_resource type="Resource" script_class="ItemDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://data/items/item_stat_modifier_data.gd" id="2_stat"]
[ext_resource type="Script" path="res://data/items/item_spell_modifier_data.gd" id="3_spell"]
[ext_resource type="Texture2D" path="res://data/items/catalogs/anneau_faille.png" id="4_icon"]

[sub_resource type="Resource" id="Stat_armor"]
script = ExtResource("2_stat")
stat_id = &"armure"
value = -10.0

[sub_resource type="Resource" id="Spell_range"]
script = ExtResource("3_spell")
modifier_name = "Portée de la faille"
range_bonus = 1

[resource]
script = ExtResource("1_item")
item_id = &"anneau_faille"
display_name = "Anneau de la faille"
description = "+1 portée maximale aux sorts modifiables. Contrepartie : -10 armure."
icon = ExtResource("4_icon")
card_texture = ExtResource("4_icon")
rarity = &"rare"
tags = Array[StringName]([&"accessory", &"first_run_equipment_reward"])
category = 2
equipment_slot = 2
stat_modifiers = Array[ItemStatModifierData]([SubResource("Stat_armor")])
spell_modifiers = Array[SpellModifier]([SubResource("Spell_range")])
