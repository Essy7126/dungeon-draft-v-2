[gd_resource type="Resource" script_class="ItemDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://data/items/item_spell_modifier_data.gd" id="2_spell"]
[ext_resource type="Texture2D" path="res://data/items/catalogs/hache_executeur.png" id="3_icon"]

[sub_resource type="Resource" id="Spell_physical"]
script = ExtResource("2_spell")
modifier_name = "Fil de l'exécuteur"
damage_percent = 0.15
damage_type_filter = 0

[sub_resource type="Resource" id="Spell_execute"]
script = ExtResource("2_spell")
modifier_name = "Exécution conditionnelle"
damage_percent = 0.25
damage_type_filter = 0
target_hp_at_or_below = 0.35

[resource]
script = ExtResource("1_item")
item_id = &"hache_executeur"
display_name = "Hache de l’exécuteur"
description = "+15 % de dégâts physiques, puis +25 % contre les cibles à 35 % de PV ou moins."
icon = ExtResource("3_icon")
rarity = &"rare"
tags = Array[StringName]([&"weapon", &"first_run_equipment_reward"])
category = 0
equipment_slot = 0
compatible_character_ids = Array[StringName]([&"warrior"])
spell_modifiers = Array[SpellModifier]([SubResource("Spell_physical"), SubResource("Spell_execute")])
