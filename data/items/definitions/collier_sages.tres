[gd_resource type="Resource" script_class="ItemDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://data/items/item_stat_modifier_data.gd" id="2_stat"]
[ext_resource type="Script" path="res://data/items/item_spell_modifier_data.gd" id="3_spell"]
[ext_resource type="Texture2D" path="res://data/items/catalogs/collier_sages.png" id="4_icon"]

[sub_resource type="Resource" id="Stat_magic"]
script = ExtResource("2_stat")
stat_id = &"resist_magique"
value = 25.0

[sub_resource type="Resource" id="Spell_support"]
script = ExtResource("3_spell")
modifier_name = "Sagesse protectrice"
healing_and_shield_percent = 0.15

[resource]
script = ExtResource("1_item")
item_id = &"collier_sages"
display_name = "Collier des sages"
description = "+25 résistance magique et +15 % puissance des soins et boucliers."
icon = ExtResource("4_icon")
card_texture = ExtResource("4_icon")
reward_fx_profile = &"arcane"
rarity = &"rare"
tags = Array[StringName]([&"accessory", &"first_run_equipment_reward"])
category = 2
equipment_slot = 2
stat_modifiers = Array[ItemStatModifierData]([SubResource("Stat_magic")])
spell_modifiers = Array[SpellModifier]([SubResource("Spell_support")])
