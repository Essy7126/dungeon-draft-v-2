[gd_resource type="Resource" script_class="ItemDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://data/items/item_stat_modifier_data.gd" id="2_stat"]
[ext_resource type="Script" path="res://data/items/item_spell_modifier_data.gd" id="3_spell"]

[sub_resource type="Resource" id="Hp"]
script = ExtResource("2_stat")
stat_id = &"max_hp"
value = 0.15
modifier_type = 1

[sub_resource type="Resource" id="Prowess"]
script = ExtResource("2_stat")
stat_id = &"attack_power"
value = 0.10
modifier_type = 1

[sub_resource type="Resource" id="Strike"]
script = ExtResource("3_spell")
modifier_name = "Souvenir de Patrocle"
target_spell_id = &"achilles_peleid_strike"
damage_percent = 0.15
require_guard_destroyed = true

[resource]
script = ExtResource("1_item")
item_id = &"odyssey_patroclus_brooch"
display_name = "Broche de Patrocle"
description = "+15 % PV max, +10 % Prouesse ; +15 % Frappe après destruction de la Garde."
tags = Array[StringName]([&"odyssey", &"achilles", &"recovery", &"hybrid"])
category = 2
equipment_slot = 2
compatible_character_ids = Array[StringName]([&"achilles"])
stat_modifiers = Array[ItemStatModifierData]([SubResource("Hp"), SubResource("Prowess")])
spell_modifiers = Array[SpellModifier]([SubResource("Strike")])
