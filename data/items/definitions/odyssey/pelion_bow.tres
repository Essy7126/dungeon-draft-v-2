[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://data/items/item_stat_modifier_data.gd" id="2_stat"]
[ext_resource type="Script" path="res://data/items/item_spell_modifier_data.gd" id="3_spell"]

[sub_resource type="Resource" id="Prowess"]
script = ExtResource("2_stat")
stat_id = &"attack_power"
value = 0.12
modifier_type = 1

[sub_resource type="Resource" id="Shot"]
script = ExtResource("3_spell")
modifier_name = "Portée du Pélion"
target_spell_id = &"achilles_pelion_shot"
range_bonus = 1
minimum_range_override = 3

[resource]
script = ExtResource("1_item")
item_id = &"odyssey_pelion_bow"
display_name = "Arc du Pélion"
description = "+12 % Prouesse ; Tir gagne 1 portée maximale et sa portée minimale devient 3."
tags = Array[StringName]([&"odyssey", &"achilles", &"chiron"])
category = 0
equipment_slot = 0
compatible_character_ids = Array[StringName]([&"achilles"])
stat_modifiers = Array[ItemStatModifierData]([SubResource("Prowess")])
spell_modifiers = Array[SpellModifier]([SubResource("Shot")])
