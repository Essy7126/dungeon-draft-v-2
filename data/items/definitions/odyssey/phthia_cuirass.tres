[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://data/items/item_stat_modifier_data.gd" id="2_stat"]

[sub_resource type="Resource" id="Hp"]
script = ExtResource("2_stat")
stat_id = &"max_hp"
value = 0.20
modifier_type = 1

[sub_resource type="Resource" id="Armor"]
script = ExtResource("2_stat")
stat_id = &"armure"
value = 30.0

[sub_resource type="Resource" id="Prowess"]
script = ExtResource("2_stat")
stat_id = &"attack_power"
value = -0.10
modifier_type = 1

[resource]
script = ExtResource("1_item")
item_id = &"odyssey_phthia_cuirass"
display_name = "Cuirasse de Phthie"
description = "+20 % PV max, +30 Armure, -10 % Prouesse."
tags = Array[StringName]([&"odyssey", &"achilles", &"aeacus"])
category = 1
equipment_slot = 1
compatible_character_ids = Array[StringName]([&"achilles"])
stat_modifiers = Array[ItemStatModifierData]([SubResource("Hp"), SubResource("Armor"), SubResource("Prowess")])
