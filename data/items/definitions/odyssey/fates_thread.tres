[gd_resource type="Resource" script_class="ItemDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://data/items/item_reactive_effect_data.gd" id="2_effect"]
[ext_resource type="Script" path="res://data/items/item_reactive_parameter_data.gd" id="3_parameter"]

[sub_resource type="Resource" id="RemainingHp"]
script = ExtResource("3_parameter")
parameter_id = &"remaining_hp"
value_type = 1
integer_value = 1

[sub_resource type="Resource" id="Consume"]
script = ExtResource("3_parameter")
parameter_id = &"consume_relic"
value_type = 2
boolean_value = true

[sub_resource type="Resource" id="Effect"]
script = ExtResource("2_effect")
trigger_id = &"lethal_hit"
target_id = &"trigger_hero"
result_id = &"lethal_reprieve_consume"
value = 0.20
frequency_id = &"per_combat"
parameters = Array[ItemReactiveParameterData]([SubResource("RemainingHp"), SubResource("Consume")])

[resource]
script = ExtResource("1_item")
item_id = &"odyssey_fates_thread"
display_name = "Fil des Moires"
description = "Une fois par run, un coup mortel laisse 1 PV, accorde 20 % PV max de Garde puis détruit la relique."
rarity = &"mythic"
tags = Array[StringName]([&"odyssey", &"universal", &"recovery"])
category = 5
reactive_effects = Array[ItemReactiveEffectData]([SubResource("Effect")])
