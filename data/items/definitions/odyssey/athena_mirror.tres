[gd_resource type="Resource" script_class="ItemDefinition" load_steps=8 format=3]

[ext_resource type="Script" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://data/items/item_reactive_effect_data.gd" id="2_effect"]
[ext_resource type="Script" path="res://data/items/item_reactive_condition_data.gd" id="3_condition"]
[ext_resource type="Script" path="res://data/items/item_reactive_parameter_data.gd" id="4_parameter"]

[sub_resource type="Resource" id="Absorbed"]
script = ExtResource("3_condition")
condition_id = &"fully_absorbed"

[sub_resource type="Resource" id="Projectile"]
script = ExtResource("3_condition")
condition_id = &"projectile"

[sub_resource type="Resource" id="Reflect"]
script = ExtResource("4_parameter")
parameter_id = &"reflect_ratio"
float_value = 0.50

[sub_resource type="Resource" id="Effect"]
script = ExtResource("2_effect")
trigger_id = &"hit_resolved"
conditions = Array[ItemReactiveConditionData]([SubResource("Absorbed"), SubResource("Projectile")])
target_id = &"trigger_hero"
result_id = &"reflect_absorbed_projectile"
value = 0.0
frequency_id = &"per_combat"
reaction_group = &"projectile_counter"
stackable = false
priority = 100
parameters = Array[ItemReactiveParameterData]([SubResource("Reflect")])

[resource]
script = ExtResource("1_item")
item_id = &"odyssey_athena_mirror"
display_name = "Miroir d’Athéna"
description = "Le premier projectile entièrement absorbé par Garde est renvoyé à 50 %."
rarity = &"legendary"
tags = Array[StringName]([&"odyssey", &"aeacus", &"hybrid"])
category = 5
reactive_effects = Array[ItemReactiveEffectData]([SubResource("Effect")])
