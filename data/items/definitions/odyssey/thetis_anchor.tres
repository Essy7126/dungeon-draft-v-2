[ext_resource type="Script" uid="uid://sm6f561h20ro" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" uid="uid://cbevwgj3ygpf1" path="res://data/items/item_reactive_effect_data.gd" id="2_effect"]
[ext_resource type="Script" uid="uid://dkfahubcultgs" path="res://data/items/item_reactive_condition_data.gd" id="3_condition"]
[ext_resource type="Script" uid="uid://ccvx4bnf07moe" path="res://data/items/item_reactive_parameter_data.gd" id="4_parameter"]
[ext_resource type="Script" uid="uid://m0ak4pxklwkk" path="res://core/spell_modifier.gd" id="6_wgghe"]
[ext_resource type="Script" uid="uid://bex4v32kexmii" path="res://data/items/item_stat_modifier_data.gd" id="7_p08yf"]
[ext_resource type="Texture2D" uid="uid://de7bnaf64csdr" path="res://assets/catabase/emerald_icons_v2/equipment/odyssey_thetis_anchor.png" id="glyph_da"]

[sub_resource type="Resource" id="Dash"]
script = ExtResource("3_condition")
condition_id = &"ability_id"
string_name_value = &"achilles_fulminant_dash"

[sub_resource type="Resource" id="GuardActive"]
script = ExtResource("3_condition")
condition_id = &"guard_active"

[sub_resource type="Resource" id="Consume"]
script = ExtResource("4_parameter")
parameter_id = &"guard_consume_ratio"
float_value = 0.3

[sub_resource type="Resource" id="SameDamage"]
script = ExtResource("4_parameter")
parameter_id = &"damage_equals_consumed"
value_type = 2
boolean_value = true

[sub_resource type="Resource" id="Push"]
script = ExtResource("4_parameter")
parameter_id = &"push_distance"
value_type = 1
integer_value = 1

[sub_resource type="Resource" id="Effect"]
script = ExtResource("2_effect")
trigger_id = &"spell_cast"
conditions = Array[ExtResource("3_condition")]([SubResource("Dash"), SubResource("GuardActive")])
result_id = &"guard_dash_conversion"
value = 0.0
frequency_id = &"per_activation"
reaction_group = &"guard_dash_conversion"
stackable = false
priority = 100
parameters = Array[ExtResource("4_parameter")]([SubResource("Consume"), SubResource("SameDamage"), SubResource("Push")])

[resource]
script = ExtResource("1_item")
item_id = &"odyssey_thetis_anchor"
display_name = "Ancre de Thétis"
description = "Percée avec Garde active consomme 30 % de la Garde, inflige cette valeur autour de l’arrivée et pousse d’une case, une fois par activation."
icon = ExtResource("glyph_da")
inventory_icon = ExtResource("glyph_da")
card_texture = ExtResource("glyph_da")
rarity = &"legendary"
tags = Array[StringName]([&"odyssey", &"aeacus", &"hybrid"])
category = 5
reactive_effects = Array[ExtResource("2_effect")]([SubResource("Effect")])
