[gd_resource type="Resource" script_class="ItemDefinition" format=3 uid="uid://cl1qx2kf0oxfi"]

[ext_resource type="Script" uid="uid://sm6f561h20ro" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" uid="uid://cbevwgj3ygpf1" path="res://data/items/item_reactive_effect_data.gd" id="2_effect"]
[ext_resource type="Script" uid="uid://dkfahubcultgs" path="res://data/items/item_reactive_condition_data.gd" id="3_condition"]
[ext_resource type="Script" uid="uid://ccvx4bnf07moe" path="res://data/items/item_reactive_parameter_data.gd" id="4_parameter"]
[ext_resource type="Script" uid="uid://m0ak4pxklwkk" path="res://core/spell_modifier.gd" id="6_fej76"]
[ext_resource type="Script" uid="uid://bex4v32kexmii" path="res://data/items/item_stat_modifier_data.gd" id="7_bqoqu"]
[ext_resource type="Texture2D" uid="uid://b1hmc51ncorvh" path="res://assets/catabase/emerald_icons_v2/equipment/odyssey_centaur_step.png" id="glyph_da"]

[sub_resource type="Resource" id="Dash"]
script = ExtResource("3_condition")
condition_id = &"ability_id"
string_name_value = &"achilles_fulminant_dash"

[sub_resource type="Resource" id="NextAbility"]
script = ExtResource("4_parameter")
parameter_id = &"next_ability_id"
value_type = 3
string_name_value = &"achilles_pelion_shot"

[sub_resource type="Resource" id="IgnoreMinimum"]
script = ExtResource("4_parameter")
parameter_id = &"ignore_minimum_range"
value_type = 2
boolean_value = true

[sub_resource type="Resource" id="DamageBonus"]
script = ExtResource("4_parameter")
parameter_id = &"damage_bonus"
float_value = 0.15

[sub_resource type="Resource" id="Effect"]
script = ExtResource("2_effect")
trigger_id = &"spell_cast"
conditions = Array[ExtResource("3_condition")]([SubResource("Dash")])
result_id = &"dash_next_shot"
value = 0.0
frequency_id = &"per_activation"
parameters = Array[ExtResource("4_parameter")]([SubResource("NextAbility"), SubResource("IgnoreMinimum"), SubResource("DamageBonus")])

[resource]
script = ExtResource("1_item")
item_id = &"odyssey_centaur_step"
display_name = "Pas du Centaure"
description = "Après Percée, le prochain Tir ignore sa portée minimale et gagne 15 % dégâts, une fois par activation."
icon = ExtResource("glyph_da")
inventory_icon = ExtResource("glyph_da")
card_texture = ExtResource("glyph_da")
rarity = &"legendary"
tags = Array[StringName]([&"odyssey", &"chiron", &"hybrid"])
category = 5
reactive_effects = Array[ExtResource("2_effect")]([SubResource("Effect")])
