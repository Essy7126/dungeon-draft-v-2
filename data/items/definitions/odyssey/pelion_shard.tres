[gd_resource type="Resource" script_class="ItemDefinition" load_steps=15 format=3]

[ext_resource type="Script" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://data/items/item_reactive_effect_data.gd" id="2_effect"]
[ext_resource type="Script" path="res://data/items/item_reactive_condition_data.gd" id="3_condition"]
[ext_resource type="Script" path="res://data/items/item_reactive_parameter_data.gd" id="4_parameter"]

[sub_resource type="Resource" id="StrikeCondition"]
script = ExtResource("3_condition")
condition_id = &"ability_id"
string_name_value = &"achilles_peleid_strike"

[sub_resource type="Resource" id="ShotCondition"]
script = ExtResource("3_condition")
condition_id = &"ability_id"
string_name_value = &"achilles_pelion_shot"

[sub_resource type="Resource" id="FirstStrike"]
script = ExtResource("4_parameter")
parameter_id = &"first_ability_id"
value_type = 3
string_name_value = &"achilles_peleid_strike"

[sub_resource type="Resource" id="SecondShot"]
script = ExtResource("4_parameter")
parameter_id = &"second_ability_id"
value_type = 3
string_name_value = &"achilles_pelion_shot"

[sub_resource type="Resource" id="DamageBonus"]
script = ExtResource("4_parameter")
parameter_id = &"damage_bonus"
float_value = 0.25

[sub_resource type="Resource" id="ArmorIgnore"]
script = ExtResource("4_parameter")
parameter_id = &"armor_ignore"
value_type = 1
integer_value = 25

[sub_resource type="Resource" id="EffectStrike"]
script = ExtResource("2_effect")
trigger_id = &"spell_cast"
conditions = Array[ItemReactiveConditionData]([SubResource("StrikeCondition")])
target_id = &"trigger_hero"
result_id = &"dual_technique"
value = 0.0
frequency_id = &"per_activation"
parameters = Array[ItemReactiveParameterData]([SubResource("FirstStrike"), SubResource("SecondShot"), SubResource("DamageBonus"), SubResource("ArmorIgnore")])

[sub_resource type="Resource" id="FirstStrike2"]
script = ExtResource("4_parameter")
parameter_id = &"first_ability_id"
value_type = 3
string_name_value = &"achilles_peleid_strike"

[sub_resource type="Resource" id="SecondShot2"]
script = ExtResource("4_parameter")
parameter_id = &"second_ability_id"
value_type = 3
string_name_value = &"achilles_pelion_shot"

[sub_resource type="Resource" id="DamageBonus2"]
script = ExtResource("4_parameter")
parameter_id = &"damage_bonus"
float_value = 0.25

[sub_resource type="Resource" id="ArmorIgnore2"]
script = ExtResource("4_parameter")
parameter_id = &"armor_ignore"
value_type = 1
integer_value = 25

[sub_resource type="Resource" id="EffectShot"]
script = ExtResource("2_effect")
trigger_id = &"spell_cast"
conditions = Array[ItemReactiveConditionData]([SubResource("ShotCondition")])
target_id = &"trigger_hero"
result_id = &"dual_technique"
value = 0.0
frequency_id = &"per_activation"
parameters = Array[ItemReactiveParameterData]([SubResource("FirstStrike2"), SubResource("SecondShot2"), SubResource("DamageBonus2"), SubResource("ArmorIgnore2")])

[resource]
script = ExtResource("1_item")
item_id = &"odyssey_pelion_shard"
display_name = "Éclat du Pélion"
description = "Si Frappe et Tir sont utilisés dans la même activation, la seconde gagne 25 % et ignore 25 Armure."
rarity = &"legendary"
tags = Array[StringName]([&"odyssey", &"hybrid"])
category = 5
reactive_effects = Array[ItemReactiveEffectData]([SubResource("EffectStrike"), SubResource("EffectShot")])
