[gd_resource type="Resource" script_class="ItemDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://data/items/item_stat_modifier_data.gd" id="2_stat"]
[ext_resource type="Texture2D" path="res://data/items/catalogs/cape_brume.png" id="3_icon"]

[sub_resource type="Resource" id="Stat_mp"]
script = ExtResource("2_stat")
stat_id = &"max_mp"
value = 1.0

[sub_resource type="Resource" id="Stat_dodge"]
script = ExtResource("2_stat")
stat_id = &"esquive"
value = 0.08

[resource]
script = ExtResource("1_item")
item_id = &"cape_brume"
display_name = "Cape de brume"
description = "+1 PM maximum et +8 % esquive."
icon = ExtResource("3_icon")
rarity = &"rare"
tags = Array[StringName]([&"armor", &"cape", &"first_run_equipment_reward"])
category = 1
equipment_slot = 1
stat_modifiers = Array[ItemStatModifierData]([SubResource("Stat_mp"), SubResource("Stat_dodge")])
