[gd_resource type="Resource" script_class="ItemDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://data/items/item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://data/items/item_stat_modifier_data.gd" id="2_stat"]
[ext_resource type="Texture2D" path="res://data/items/catalogs/couronne.png" id="3_icon"]

[sub_resource type="Resource" id="Stat_ap"]
script = ExtResource("2_stat")
stat_id = &"max_ap"
value = 1.0

[sub_resource type="Resource" id="Stat_hp"]
script = ExtResource("2_stat")
stat_id = &"max_hp"
value = -15.0

[resource]
script = ExtResource("1_item")
item_id = &"couronne"
display_name = "Couronne"
description = "+1 PA maximum. Contrepartie : -15 PV maximum."
icon = ExtResource("3_icon")
card_texture = ExtResource("3_icon")
rarity = &"rare"
tags = Array[StringName]([&"accessory", &"head", &"first_run_equipment_reward"])
category = 2
equipment_slot = 2
stat_modifiers = Array[ItemStatModifierData]([SubResource("Stat_ap"), SubResource("Stat_hp")])
