[resource]
script = ExtResource("3_bajia")
item_id = &"lyre_d_orphee"
display_name = "Lyre d’Orphée"
description = "Le premier ennemi qui termine son tour adjacent à un héros contrôlé reçoit un malus de 1 PM au début de son prochain tour. La limite « une fois » se réinitialise à chaque tour d’ennemi qui se termine adjacent à un héros, et non strictement à chaque tour du héros : c’est la modélisation la plus fidèle disponible dans l’éditeur actuel, et elle reste déterministe."
tags = Array[StringName]([&"first_run_equipment_reward"])
category = 5
reactive_effects = Array[ExtResource("1_0dlei")]([SubResource("Resource_6mbpb")])
