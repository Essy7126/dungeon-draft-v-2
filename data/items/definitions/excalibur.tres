[ext_resource type="Script" path="res://data/items/item_spell_modifier_data.gd" id="3_spell"]
[ext_resource type="Texture2D" path="res://data/items/catalogs/excalibur.png" id="4_icon"]

[sub_resource type="Resource" id="Stat_armor"]
script = ExtResource("2_stat")
