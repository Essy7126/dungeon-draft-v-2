description = "+10 % de dégâts physiques et +1 case aux poussées produites par les sorts."
icon = ExtResource("3_icon")
card_texture = ExtResource("3_icon")
reward_fx_profile = &"nature"
rarity = &"rare"
tags = Array[StringName]([&"weapon", &"first_run_equipment_reward"])
category = 0
equipment_slot = 0
compatible_character_ids = Array[StringName]([&"warrior"])
spell_modifiers = Array[SpellModifier]([SubResource("Spell_troll")])
