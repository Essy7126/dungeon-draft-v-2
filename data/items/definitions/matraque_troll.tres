[ext_resource type="Texture2D" path="res://data/items/catalogs/matraque_troll.png" id="3_icon"]

[sub_resource type="Resource" id="Spell_troll"]
script = ExtResource("2_spell")
modifier_name = "Impact du troll"
damage_percent = 0.1
damage_type_filter = 0
push_bonus = 1

[resource]
script = ExtResource("1_item")
item_id = &"matraque_troll"
